// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  lastName      String
  email         String   @unique
  password      String
  description   String?
  locationId    String
  locationName  String
  position      String
  averageRating Float    @default(0)
  matchesPlayed Int      @default(0)
  birthDate     DateTime
  role          String   @default("user") // user | moderator | admin

  sentFriendRequests     FriendRequest[] @relation("Requester")
  receivedFriendRequests FriendRequest[] @relation("Receiver")

  notifications  Notification[]
  createdMatches Match[]

  ratingsGiven    Rating[] @relation("Rater")
  ratingsReceived Rating[] @relation("Rated")

  occupiedPositions  TeamPosition[] @relation("Occupant")
  requestedPositions TeamPosition[] @relation("PositionRequester")
}

model Match {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  time      String
  fieldType String
  privacy   String
  status    String   @default("open")
  fieldId   Int
  creatorId Int

  field         Field          @relation(fields: [fieldId], references: [id])
  creator       User           @relation(fields: [creatorId], references: [id])
  ratings       Rating[]
  notifications Notification[]
  teams         MatchTeam[]
}

model Field {
  id           Int    @id @default(autoincrement())
  name         String
  address      String
  type         String
  locationId   String
  locationName String

  matches Match[]
}

model FriendRequest {
  id          Int      @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      String
  date        DateTime @default(now())

  requester User @relation("Requester", fields: [requesterId], references: [id])
  receiver  User @relation("Receiver", fields: [receiverId], references: [id])
}

model Notification {
  id      Int      @id @default(autoincrement())
  userId  Int
  matchId Int?
  type    String
  message String
  date    DateTime @default(now())
  read    Boolean  @default(false)

  user  User   @relation(fields: [userId], references: [id])
  match Match? @relation(fields: [matchId], references: [id]) // "?" para coincidir con "Int?"
}

model Rating {
  id      Int      @id @default(autoincrement())
  matchId Int
  raterId Int
  ratedId Int
  stars   Int
  comment String
  date    DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])
  rater User  @relation("Rater", fields: [raterId], references: [id])
  rated User  @relation("Rated", fields: [ratedId], references: [id])

  // Evita dos ratings del mismo usuario a otro usuario en el mismo partido
  @@unique([matchId, raterId, ratedId])
}

model MatchTeam {
  id      Int    @id @default(autoincrement())
  name    String
  color   String
  matchId Int

  match     Match          @relation(fields: [matchId], references: [id])
  positions TeamPosition[]
}

model TeamPosition {
  id           Int      @id @default(autoincrement())
  positionType String
  status       String   @default("free")
  role         String   @default("player")
  matchTeamId  Int
  occupantId   Int?
  requesterId  Int?
  date         DateTime @default(now())

  matchTeam MatchTeam @relation(fields: [matchTeamId], references: [id])
  occupant  User?     @relation("Occupant", fields: [occupantId], references: [id])
  requester User?     @relation("PositionRequester", fields: [requesterId], references: [id])
}
