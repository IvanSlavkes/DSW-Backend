# Use a persistent PostgreSQL service. Set both variables to the same database unless your provider requires separate pooled/direct URLs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Use a long, private value. Do not commit the real secret.
JWT_SECRET="replace-with-a-private-secret"

# Optional; defaults to 3000.
PORT=3000

# Optional, used when creating notifications that send email.
EMAIL_USER=
EMAIL_PASS=
