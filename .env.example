# Runtime URL (use Neon pooled connection string, hostname includes -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:PORT/DATABASE?sslmode=require"

# Direct URL used by Prisma CLI for migrations (Neon direct connection string).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require"

# Use a long, private value. Do not commit the real secret.
JWT_SECRET="replace-with-a-private-secret"

# Optional; defaults to 3000.
PORT=3000

# Optional, used when creating notifications that send email.
EMAIL_USER=
EMAIL_PASS=
